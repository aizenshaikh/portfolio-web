# Postgres connection string from Neon (https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-with-32-byte-hex-secret"

# Public URL of the deployed site (for production set to your vercel URL or custom domain)
NEXTAUTH_URL="http://localhost:3000"

# Admin login credentials (used by prisma seed to create the admin user)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-strong-password"
